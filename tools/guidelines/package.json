{
  "name": "@mszczygiel-projects/ui-core-guidelines",
  "version": "0.0.0",
  "private": true,
  "description": "Repository tooling: builds the guidelines that Figma's agent reads in the published libraries, from the specifications, the component pages and the token manifest.",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@mszczygiel-projects/ui-core-foundations": "workspace:^",
    "@mszczygiel-projects/ui-core-shared": "workspace:^"
  },
  "nx": {
    "name": "guidelines",
    "tags": [
      "type:tool"
    ],
    "targets": {
      "guidelines": {
        "command": "node src/cli.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/apps/storybook/src/components/**/*.mdx",
          "{workspaceRoot}/packages/icons/icon-names.txt"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "cache": true
      }
    }
  }
}
