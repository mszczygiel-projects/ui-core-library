{
  "name": "ui-core-library",
  "version": "0.0.0",
  "private": true,
  "description": "UI Core Library: design tokens, icons, web components and React components.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:root": "eslint \"*.{js,mjs,ts}\"",
    "secrets:check": "secretlint \"**/*\"",
    "deps:audit": "pnpm audit --prod",
    "skills:install": "DO_NOT_TRACK=1 pnpm dlx skills@1.7.2 experimental_install",
    "verify": "nx sync:check && pnpm format:check && pnpm lint:root && pnpm lint:css && nx run-many -t lint typecheck test build check-package && pnpm release:check && pnpm secrets:check && pnpm deps:audit && pnpm figma:check",
    "tokens:snapshot": "nx run foundations:test -- -u",
    "release:check": "nx release version 1.0.0 --first-release --dry-run",
    "icons:snapshot": "nx run icons:test -- -u",
    "lint:css": "stylelint \"packages/**/*.css\" \"apps/**/*.css\" --allow-empty-input",
    "shared:snapshot": "nx run shared:test -- -u",
    "figma:react": "DO_NOT_TRACK=1 figma connect --config figma.config.json --exit-on-unreadable-files --skip-update-check",
    "figma:wc": "DO_NOT_TRACK=1 figma connect --config figma.web-components.config.json --exit-on-unreadable-files --skip-update-check",
    "figma:check": "pnpm figma:react parse --dry-run && pnpm figma:wc parse --dry-run",
    "guidelines:build": "nx run guidelines:guidelines"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@eslint/js": "catalog:",
    "@figma/code-connect": "catalog:",
    "@nx/eslint": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@nx/js": "catalog:",
    "@nx/vitest": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "@stencil/eslint-plugin": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "jsonc-eslint-parser": "catalog:",
    "lefthook": "catalog:",
    "nx": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "secretlint": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-plugin-use-baseline": "catalog:",
    "stylelint-use-logical": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
