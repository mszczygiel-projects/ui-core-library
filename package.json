{
  "name": "ui-core-library",
  "version": "0.1.2",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "storybook": "nx run storybook:storybook",
    "foundations:build": "nx run foundations:build",
    "icons:build": "nx run icons:build",
    "build": "nx run-many --target=build",
    "publish": "pnpm -r --filter @mszczygiel-projects/ui-core-foundations --filter @mszczygiel-projects/ui-core-icons --filter @mszczygiel-projects/ui-core-react --filter @mszczygiel-projects/ui-core-wc publish --access restricted --no-git-checks",
    "release:publish": "pnpm build && pnpm test && pnpm run publish",
    "release:patch": "node tools/release.mjs patch",
    "release:minor": "node tools/release.mjs minor",
    "release:major": "node tools/release.mjs major",
    "release:version": "node tools/release.mjs",
    "lint": "nx run-many --target=lint",
    "lint:fix": "nx run-many --target=lint --configuration=fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "nx run-many --target=test",
    "test:foundations": "nx run foundations:test",
    "test:icons": "pnpm --filter @mszczygiel-projects/ui-core-icons test",
    "test:react": "nx run react:test",
    "test:wc": "nx run wc:test",
    "chromatic": "nx run storybook:chromatic"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nx/eslint": "^20.0.0",
    "@nx/js": "^20.0.0",
    "@nx/vite": "^20.0.0",
    "@storybook/addon-mcp": "^0.6.0",
    "eslint": "^9.0.0",
    "nx": "^20.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.1"
  }
}
