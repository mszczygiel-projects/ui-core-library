{
  "name": "@mszczygiel-projects/ui-core-wc",
  "version": "0.7.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "customElements": "custom-elements.json",
  "scripts": {
    "build": "pnpm run cem:build && tsc --project tsconfig.build.json && tsx scripts/generate-llms.ts",
    "cem:build": "cem analyze --config custom-elements-manifest.config.mjs",
    "test": "wtr && vitest run",
    "test:watch": "wtr --watch",
    "lint": "eslint src scripts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mszczygiel-projects/ui-core-library.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependencies": {
    "@mszczygiel-projects/ui-core-foundations": "workspace:*"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@mszczygiel-projects/ui-core-icons": "workspace:*",
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@mszczygiel-projects/ui-core-foundations": "workspace:*",
    "@open-wc/testing": "^4.0.0",
    "@types/react": "^18.0.0",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.19.0",
    "@web/test-runner-playwright": "^0.11.0",
    "react": "^18.0.0",
    "tsx": "^4.0.0",
    "vitest": "^2.0.0"
  }
}
