{
  "name": "@mszczygiel-projects/ui-core-web-components",
  "version": "0.0.0",
  "description": "The web components of UI Core Library, written with Stencil, for any framework or none.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/ui-button.d.ts",
      "default": "./dist/components/ui-button.js"
    },
    "./icon-button": {
      "types": "./dist/components/ui-icon-button.d.ts",
      "default": "./dist/components/ui-icon-button.js"
    },
    "./link-button": {
      "types": "./dist/components/ui-link-button.d.ts",
      "default": "./dist/components/ui-link-button.js"
    },
    "./loader": {
      "types": "./dist/components/ui-loader.d.ts",
      "default": "./dist/components/ui-loader.js"
    },
    "./text-field": {
      "types": "./dist/components/ui-text-field.d.ts",
      "default": "./dist/components/ui-text-field.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./package.json": "./package.json"
  },
  "customElements": "dist/custom-elements.json",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mszczygiel-projects/ui-core-library.git",
    "directory": "packages/web-components"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "dependencies": {
    "@mszczygiel-projects/ui-core-foundations": "workspace:^",
    "@mszczygiel-projects/ui-core-shared": "workspace:^"
  },
  "nx": {
    "name": "web-components",
    "tags": [
      "type:web-components"
    ],
    "targets": {
      "build": {
        "command": "stencil build && node scripts/finish-build.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "cache": true
      },
      "typecheck": {
        "command": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.tools.json && tsc -p tsconfig.spec.json",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build",
          "^build"
        ],
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ]
      },
      "check-package": {
        "command": "publint --strict . && attw --pack . --profile esm-only --exclude-entrypoints ./custom-elements.json && tsc -p tsconfig.dist.json",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "production"
        ],
        "cache": true
      },
      "test": {
        "dependsOn": [
          "build",
          "^build"
        ]
      },
      "lint": {
        "dependsOn": [
          "build",
          "^build"
        ]
      }
    }
  },
  "devDependencies": {
    "@figma/code-connect": "catalog:",
    "@stencil/core": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "vitest": "catalog:"
  }
}
