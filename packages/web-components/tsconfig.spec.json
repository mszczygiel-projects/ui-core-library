{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["@figma/code-connect/figma-types-no-require"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.figma.ts",
    "src/internal/test-utils.ts",
    "vitest.config.ts"
  ]
}
