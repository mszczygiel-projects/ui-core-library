{
  // Checks the published declarations as a consumer that does not skip them would.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": []
  },
  "include": ["dist/**/*.d.ts"]
}
