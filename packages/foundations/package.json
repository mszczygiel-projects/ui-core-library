{
  "name": "@mszczygiel-projects/ui-core-foundations",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./tailwind.css": "./src/tailwind.css",
    "./reset.css": "./src/reset.css",
    "./typography.css": "./src/typography.css",
    "./base.css": "./src/base.css",
    "./fonts/default.css": "./src/fonts/default.css"
  },
  "bin": {
    "ui-core-foundations": "./dist/scripts/cli.js"
  },
  "files": [
    "dist",
    "src/**/*.css",
    "src/tokens.ts"
  ],
  "scripts": {
    "build": "tsx scripts/cli.ts build && tsc --project tsconfig.build.json && tsc --project tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mszczygiel-projects/ui-core-library.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "vitest": "^2.0.0"
  }
}
