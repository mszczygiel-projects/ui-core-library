{
  "name": "@mszczygiel-projects/ui-core-shared",
  "version": "0.0.0",
  "description": "What the web components and the React components of UI Core Library share: the specifications of the components and pure functions, safe for server rendering.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./badge": {
      "types": "./dist/components/badge.d.ts",
      "default": "./dist/components/badge.js"
    },
    "./button": {
      "types": "./dist/components/button.d.ts",
      "default": "./dist/components/button.js"
    },
    "./chip": {
      "types": "./dist/components/chip.d.ts",
      "default": "./dist/components/chip.js"
    },
    "./component": {
      "types": "./dist/components/component.d.ts",
      "default": "./dist/components/component.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./date": {
      "types": "./dist/utils/date.d.ts",
      "default": "./dist/utils/date.js"
    },
    "./icon-button": {
      "types": "./dist/components/icon-button.d.ts",
      "default": "./dist/components/icon-button.js"
    },
    "./link-button": {
      "types": "./dist/components/link-button.d.ts",
      "default": "./dist/components/link-button.js"
    },
    "./loader": {
      "types": "./dist/components/loader.d.ts",
      "default": "./dist/components/loader.js"
    },
    "./locale": {
      "types": "./dist/utils/locale.d.ts",
      "default": "./dist/utils/locale.js"
    },
    "./notification": {
      "types": "./dist/components/notification.d.ts",
      "default": "./dist/components/notification.js"
    },
    "./numeric": {
      "types": "./dist/utils/numeric.d.ts",
      "default": "./dist/utils/numeric.js"
    },
    "./one-of": {
      "types": "./dist/utils/one-of.d.ts",
      "default": "./dist/utils/one-of.js"
    },
    "./paginate": {
      "types": "./dist/utils/paginate.d.ts",
      "default": "./dist/utils/paginate.js"
    },
    "./password-field": {
      "types": "./dist/components/password-field.d.ts",
      "default": "./dist/components/password-field.js"
    },
    "./search-field": {
      "types": "./dist/components/search-field.d.ts",
      "default": "./dist/components/search-field.js"
    },
    "./text": {
      "types": "./dist/utils/text.d.ts",
      "default": "./dist/utils/text.js"
    },
    "./text-field": {
      "types": "./dist/components/text-field.d.ts",
      "default": "./dist/components/text-field.js"
    },
    "./textarea-field": {
      "types": "./dist/components/textarea-field.d.ts",
      "default": "./dist/components/textarea-field.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mszczygiel-projects/ui-core-library.git",
    "directory": "packages/shared"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "nx": {
    "name": "shared",
    "tags": [
      "type:shared"
    ],
    "targets": {
      "test-other-machine": {
        "command": "vitest run",
        "options": {
          "cwd": "{projectRoot}",
          "env": {
            "TZ": "Pacific/Kiritimati",
            "LC_ALL": "pl_PL.UTF-8"
          }
        },
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "cache": true
      },
      "check-package": {
        "command": "publint --strict . && attw --pack . --profile esm-only",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "production"
        ],
        "cache": true
      }
    }
  }
}
