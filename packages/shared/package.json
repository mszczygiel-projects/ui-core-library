  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mszczygiel-projects/ui-core-library.git",
    "directory": "packages/shared"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "nx": {
    "name": "shared",
    "tags": [
      "type:shared"
    ],
    "targets": {
      "test-other-machine": {
        "command": "vitest run",
        "options": {
          "cwd": "{projectRoot}",
          "env": {
            "TZ": "Pacific/Kiritimati",
            "LC_ALL": "pl_PL.UTF-8"
          }
        },
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "cache": true
      },
      "check-package": {
        "command": "publint --strict . && attw --pack . --profile esm-only",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "production"
        ],
        "cache": true
      }
    }
  }
}
