{
  "name": "@mszczygiel-projects/ui-core-icons",
  "version": "0.9.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/svg-map.js",
      "types": "./dist/svg-map.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "bin": {
    "ui-core-icons": "./dist/scripts/cli.js"
  },
  "files": [
    "dist",
    "src/svg"
  ],
  "scripts": {
    "build": "tsx scripts/cli.ts build && tsc --project tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mszczygiel-projects/ui-core-library.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@svgr/core": "^8.0.0",
    "@svgr/plugin-jsx": "^8.0.0",
    "svgo": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "tsx": "^4.0.0",
    "vitest": "^2.0.0"
  }
}
