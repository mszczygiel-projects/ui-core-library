{
  "name": "@mszczygiel-projects/ui-core-react",
  "version": "0.13.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c && tsc --build tsconfig.build.json --emitDeclarationOnly --force && tsx scripts/generate-llms.ts",
    "test": "vitest run && vitest run --config vitest.scripts.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src scripts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mszczygiel-projects/ui-core-library.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependencies": {
    "@mszczygiel-projects/ui-core-foundations": "workspace:*",
    "@mszczygiel-projects/ui-core-icons": "workspace:*",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "devDependencies": {
    "@mszczygiel-projects/ui-core-foundations": "workspace:*",
    "@mszczygiel-projects/ui-core-icons": "workspace:*",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^29.1.0",
    "react": "^18.0.0",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^18.0.0",
    "rollup": "^4.60.2",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
