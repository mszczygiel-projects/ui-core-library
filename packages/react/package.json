{
  "name": "@mszczygiel-projects/ui-core-react",
  "version": "0.0.0",
  "description": "The React components of UI Core Library, safe for server rendering.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mszczygiel-projects/ui-core-library.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@mszczygiel-projects/ui-core-foundations": "workspace:^",
    "@mszczygiel-projects/ui-core-shared": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "nx": {
    "name": "react",
    "tags": [
      "type:react"
    ],
    "targets": {
      "build-styles": {
        "command": "node scripts/build-styles.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "{projectRoot}/src/**/*.css",
          "{projectRoot}/scripts/**/*"
        ],
        "outputs": [
          "{projectRoot}/dist/styles.css"
        ],
        "cache": true
      },
      "build": {
        "dependsOn": [
          "build-styles",
          "^build"
        ]
      },
      "check-package": {
        "command": "publint --strict . && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "production"
        ],
        "cache": true
      }
    }
  }
}
